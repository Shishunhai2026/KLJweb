# production
/build

# 运行期数据（线索、AI 会话）——含个人信息，绝不入库
/data/runtime/

# 构建产物（AI 检索索引、嵌入向量）
/data/generated/

# 测试
/coverage
/test-results
/playwright-report
/blob-report
/.vitest

# 开发期截图产物（scripts/_shot-*.mjs、_screenshot.mjs 的输出）
