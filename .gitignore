/.preview/

# misc
.DS_Store
*.pem
.vscode/
.idea/

# 环境变量
.env
.env*.local
!.env.example

# 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

