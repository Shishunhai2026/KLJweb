{
  "name": "heyilin-sleep-master",
  "version": "1.0.0",
  "private": true,
  "description": "和颐林·睡眠大师官方网站 — 睡眠健康知识与睡眠问题解决方案平台",
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run content:lint",
    "content:lint": "tsx scripts/validate-content.ts",
    "content:index": "tsx scripts/build-kb-index.ts",
    "check:links": "node scripts/check-links.mjs",
    "preview:shots": "node scripts/_screenshot.mjs",
    "prebuild": "npm run content:lint"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
