    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.89.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "schema-dts": "^2.0.0",
