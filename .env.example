# 复制为 .env 后填写。.env 不进版本库。
#
# ⚠️ 本项目是纯静态导出（output: 'export'），`.env` 只在**构建时**被读取——
# origin、备案号等会被烘进 HTML，构建后无法再修改。
# 服务器上不存在 Node 运行时，因此盐值、线索文件路径等**运行期**配置不在这里，
# 而在服务器的 klj-private/config.php。见 deploy/README.md。

# ---------------------------------------------------------------------------
# 站点
# ---------------------------------------------------------------------------
# 生产环境的正式域名（含协议，不带尾斜杠）。所有 canonical / sitemap / JSON-LD
# 的绝对地址都从这里派生，代码中任何地方都不得硬编码域名。
#
# ⚠️ 生产构建必须设置：scripts/check-env.ts 会在 prebuild 拦下缺失、格式错误、
# 或指向 localhost 的取值——因为静态站的地址是烘进 HTML 的，构建后无法修补。
# 开发环境可留空，默认 http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://example.com

# 备案号，展示在页脚。大陆服务器上线必须展示。
NEXT_PUBLIC_ICP=苏ICP备00000000号-1

# URL 形态固定为**带尾斜杠**（/about/），由 next.config.ts 的 trailingSlash: true
# 与 lib/seo/site.ts 的 TRAILING_SLASH 常量共同决定，不通过环境变量切换。
# 改动必须同时改这两处，否则 canonical 会与实际服务的形态不符且不会报错。

# ---------------------------------------------------------------------------
# 线索存储（仅 php -S 本地调试时需要，生产不用）
# ---------------------------------------------------------------------------
# 生产环境由 public/api/leads.php 承接，配置在服务器的 klj-private/config.php。
# 本地用 `php -S` 调试该接口时，把 config.php 放在 out/api/../../klj-private/ 下即可。
# lib/leads/store.ts 保留为 PHP 实现的对照规范，不参与静态构建。

# ---------------------------------------------------------------------------
# 统计（M7）
# ---------------------------------------------------------------------------
# 留空则对应脚本/组件自动跳过，不会报错
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_BAIDU_TONGJI_ID=
NEXT_PUBLIC_CLARITY_ID=
BAIDU_PUSH_TOKEN=
