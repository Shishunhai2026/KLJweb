# ---------------------------------------------------------------------------
# 站点
# ---------------------------------------------------------------------------
# 生产环境的正式域名（含协议，不带尾斜杠）。所有 canonical / sitemap / JSON-LD
# 的绝对地址都从这里派生，代码中任何地方都不得硬编码域名。
# 开发环境可留空，默认 http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------------------------------------------------------------------------
# AI 睡眠助手
# ---------------------------------------------------------------------------
# V1 默认不配置任何 LLM，此时使用「知识库检索 + 规则化回答」路径，全部功能可正常使用。
# 填入以下变量即自动升级为完整 RAG，无需改动任何代码。
#
# AI_PROVIDER 可选：deepseek | qwen | openai | openai-compatible
# 不设置时自动降级为内置的 NullProvider（模板回答）。
# AI_PROVIDER=
# AI_API_KEY=
# AI_BASE_URL=          # 留空则使用对应 provider 的默认地址
# AI_MODEL=

# ---------------------------------------------------------------------------
# 线索存储
# ---------------------------------------------------------------------------
# jsonl（默认，追加写本地文件）| postgres
# 注意：jsonl 模式下 PM2 必须使用 fork 模式且单实例，多进程并发写会交错损坏文件。
LEAD_STORE=jsonl
LEAD_STORE_PATH=./data/runtime/leads.jsonl

# 用于对访客 IP 做加盐哈希（绝不存储原始 IP）。生产环境必须设置为随机长字符串。
IP_HASH_SALT=change-me-to-a-long-random-string

# postgres 模式下的连接串（LEAD_STORE=postgres 时必填）
# DATABASE_URL=

# ---------------------------------------------------------------------------
# 统计（M7）
# ---------------------------------------------------------------------------
# 留空则对应脚本/组件自动跳过，不会报错
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_BAIDU_TONGJI_ID=
NEXT_PUBLIC_CLARITY_ID=
BAIDU_PUSH_TOKEN=
